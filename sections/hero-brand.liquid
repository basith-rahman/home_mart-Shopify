{% liquid
  assign text_color = section.settings.text_color | default: settings.page_text_color
  assign background_color = section.settings.background_color | default: settings.page_background_color
%}

<section
  class="hero-brand"
  style="
    --text-color: {{ text_color }};
    --background-color: {{ background_color }};
    --padding-block: {{ section.settings.padding_block }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="hero-brand__container">
    <!-- Animated background blobs -->
    <div class="hero-brand__blobs">
      <div class="hero-brand__blob hero-brand__blob--1"></div>
      <div class="hero-brand__blob hero-brand__blob--2"></div>
      <div class="hero-brand__blob hero-brand__blob--3"></div>
    </div>

    <!-- Logo grid -->
    <div class="hero-brand__logos-grid">
      {% for i in (1..3) %}
        <div class="hero-brand__logo-item">
          <img 
            src="{{ 'logo-lg-0' | append: i | append: '.jpg' | asset_url }}" 
            alt="HomeBy Logo"
            class="hero-brand__logo"
          >
        </div>
      {% endfor %}
    </div>

    <!-- Content -->
    <div class="hero-brand__content">
      <h1 class="hero-brand__title">{{ section.settings.title | default: 'HomeBy' }}</h1>
      <p class="hero-brand__subtitle">{{ section.settings.subtitle }}</p>
      
      {% if section.settings.cta_text != blank %}
        <a href="{{ section.settings.cta_link }}" class="button button--primary">
          {{ section.settings.cta_text }}
        </a>
      {% endif %}
    </div>

    <!-- Bottom logo accent -->
    <div class="hero-brand__accent-logo">
      <img 
        src="{{ 'logo-xl.jpg' | asset_url }}" 
        alt="HomeBy"
        class="hero-brand__accent-image"
      >
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-brand {
    background-color: var(--background-color);
    color: var(--text-color);
    padding-block: var(--padding-block);
    position: relative;
    overflow: hidden;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-brand__container {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    z-index: 1;
  }

  .hero-brand__blobs {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.05;
    z-index: 0;
  }

  .hero-brand__blob {
    position: absolute;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    background: var(--text-color);
    animation: float-blob 15s ease-in-out infinite;
  }

  .hero-brand__blob--1 {
    width: 300px;
    height: 300px;
    top: -50px;
    left: -100px;
    animation-duration: 15s;
  }

  .hero-brand__blob--2 {
    width: 250px;
    height: 250px;
    top: 50%;
    right: -50px;
    animation-duration: 18s;
    animation-delay: 2s;
  }

  .hero-brand__blob--3 {
    width: 200px;
    height: 200px;
    bottom: -50px;
    left: 50%;
    animation-duration: 20s;
    animation-delay: 4s;
  }

  @keyframes float-blob {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(30px, -50px) rotate(90deg);
    }
    50% {
      transform: translate(-20px, 20px) rotate(180deg);
    }
    75% {
      transform: translate(50px, 50px) rotate(270deg);
    }
  }

  .hero-brand__logos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    gap: 30px;
    max-width: 400px;
    width: 100%;
    animation: fade-in 0.8s ease-out;
  }

  .hero-brand__logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
  }

  .hero-brand__logo-item:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-5px);
  }

  .hero-brand__logo {
    max-width: 100%;
    height: auto;
    max-height: 80px;
  }

  .hero-brand__content {
    text-align: center;
    animation: fade-in 0.8s ease-out 0.2s both;
    max-width: 600px;
  }

  .hero-brand__title {
    font-size: clamp(2.5rem, 10vw, 4rem);
    font-weight: 700;
    margin: 0 0 20px;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--text-color) 0%, var(--text-color) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-brand__subtitle {
    font-size: clamp(1rem, 4vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-color);
    opacity: 0.85;
    margin: 0 0 30px;
  }

  .hero-brand__accent-logo {
    max-width: 200px;
    opacity: 0.1;
    animation: fade-in 0.8s ease-out 0.4s both;
  }

  .hero-brand__accent-image {
    width: 100%;
    height: auto;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media screen and (max-width: 768px) {
    .hero-brand {
      min-height: 400px;
      padding-block: 40px;
    }

    .hero-brand__container {
      gap: 30px;
    }

    .hero-brand__logos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      max-width: 250px;
    }

    .hero-brand__logo-item {
      padding: 15px;
    }

    .hero-brand__blob--1 {
      width: 150px;
      height: 150px;
    }

    .hero-brand__blob--2 {
      width: 120px;
      height: 120px;
    }

    .hero-brand__blob--3 {
      width: 100px;
      height: 100px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Premium Brand Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "HomeBy"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Your Premium Home Essentials Collection"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f7f5f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2f3133"
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding",
      "default": 60
    }
  ]
}
{% endschema %}
