{% liquid
  assign text_color = section.settings.text_color | default: settings.page_text_color
  assign background_color = section.settings.background_color | default: settings.page_background_color
%}

<section
  class="hero-brand"
  style="
    --text-color: {{ text_color }};
    --background-color: {{ background_color }};
    --padding-block: {{ section.settings.padding_block }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="hero-brand__container">
    <!-- Animated background blobs -->
    <div class="hero-brand__blobs">
      <div class="hero-brand__blob hero-brand__blob--1"></div>
      <div class="hero-brand__blob hero-brand__blob--2"></div>
      <div class="hero-brand__blob hero-brand__blob--3"></div>
    </div>

    <!-- Content -->
    <div class="hero-brand__content">
      <img 
        src="{{ 'logo-lg-02-removebg.png' | asset_url }}" 
        alt="HomeBy"
        class="hero-brand__logo-main"
      >
    </div>

    <!-- Bottom logo accent -->
    <div class="hero-brand__accent-logo">
      <img 
        src="{{ 'logo-xl.jpg' | asset_url }}" 
        alt="HomeBy"
        class="hero-brand__accent-image"
      >
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-brand {
    background-color: var(--background-color);
    color: var(--text-color);
    padding-block: var(--padding-block);
    position: relative;
    overflow: hidden;
    height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-brand__container {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .hero-brand__blobs {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.05;
    z-index: 0;
  }

  .hero-brand__blob {
    position: absolute;
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    background: var(--text-color);
    animation: float-blob 15s ease-in-out infinite;
  }

  .hero-brand__blob--1 {
    width: 300px;
    height: 300px;
    top: -50px;
    left: -100px;
    animation-duration: 15s;
  }

  .hero-brand__blob--2 {
    width: 250px;
    height: 250px;
    top: 50%;
    right: -50px;
    animation-duration: 18s;
    animation-delay: 2s;
  }

  .hero-brand__blob--3 {
    width: 200px;
    height: 200px;
    bottom: -50px;
    left: 50%;
    animation-duration: 20s;
    animation-delay: 4s;
  }

  @keyframes float-blob {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    25% {
      transform: translate(30px, -50px) rotate(90deg);
    }
    50% {
      transform: translate(-20px, 20px) rotate(180deg);
    }
    75% {
      transform: translate(50px, 50px) rotate(270deg);
    }
  }

  .hero-brand__content {
    text-align: center;
    animation: fade-in 0.8s ease-out 0.2s both;
    max-width: 600px;
    padding: 20px;
    z-index: 2;
  }

  .hero-brand__logo-main {
    max-width: clamp(200px, 40vw, 420px);
    height: auto;
    margin: 0 auto;
    display: block;
    object-fit: contain;
  }

  .hero-brand__accent-logo {
    position: absolute;
    bottom: -80px;
    right: -100px;
    max-width: 400px;
    opacity: 0.03;
    animation: fade-in 0.8s ease-out 0.4s both;
    pointer-events: none;
  }

  .hero-brand__accent-image {
    width: 100%;
    height: auto;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media screen and (max-width: 768px) {
    .hero-brand {
      height: 50vh;
      padding-block: 40px;
    }

    .hero-brand__container {
      gap: 20px;
      padding: 0 15px;
    }

    .hero-brand__logo-main {
      max-width: clamp(160px, 50vw, 280px);
    }

    .hero-brand__logos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
      max-width: 250px;
    }

    .hero-brand__logo-item {
      padding: 15px;
    }

    .hero-brand__blob--1 {
      width: 150px;
      height: 150px;
    }

    .hero-brand__blob--2 {
      width: 120px;
      height: 120px;
    }

    .hero-brand__blob--3 {
      width: 100px;
      height: 100px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Premium Brand Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "HomeBy"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Your Premium Home Essentials Collection"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Button Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f7f5f2"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2f3133"
    },
    {
      "type": "range",
      "id": "padding_block",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding",
      "default": 60
    }
  ]
}
{% endschema %}
